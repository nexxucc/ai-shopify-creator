        {
            "parameters": {
                "jsCode": "const response = $input.first().json;\nconst prev = $('Parse Researcher').first().json;\nlet contentData;\ntry { contentData = JSON.parse(response.choices[0].message.content); } catch(e) { contentData = {products: []}; }\nconst products = prev.products.map(function(p, i) { const content = (contentData.products || [])[i] ? (contentData.products[i].content || {}) : {}; return Object.assign({}, p, {content: content}); });\nconst systemPrompt = \"You are an expert eCommerce Pricing Optimizer. Set optimal prices. Respond ONLY with valid JSON. OUTPUT: {products: [{title, pricing: {finalPrice: number, compareAtPrice: number, margin: string}}]}\";\nconst userPrompt = \"Optimize pricing for: \" + JSON.stringify(products.map(function(p){return {title:p.title, variants:p.variants}})) + \". Budget Tier: \" + (prev.blueprint.budgetTier || \"mid\");\nreturn [{json: { blueprint: prev.blueprint, products, body: { model: \"llama-3.3-70b-versatile\", messages: [{role: \"system\", content: systemPrompt}, {role: \"user\", content: userPrompt}], temperature: 0.5, max_tokens: 4000, response_format: {type: \"json_object\"} }}}];"
            },
