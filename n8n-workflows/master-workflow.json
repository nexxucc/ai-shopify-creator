        {
            "parameters": {
                "jsCode": "const response = $input.first().json;\nconst prev = $('Parse Pricing').first().json;\nlet themeData;\ntry { themeData = JSON.parse(response.choices[0].message.content); } catch(e) { themeData = {theme: {}}; }\nconst blueprint = prev.blueprint;\nconst products = prev.products;\nconst collections = blueprint.collections || [];\nconst items = collections.map(function(c) { return {json: {blueprint: blueprint, products: products, collection: {title: c.name, body_html: \"<p>\" + (c.description || \"\") + \"</p>\"}}}; });\nreturn items.length > 0 ? items : [{json: {blueprint: blueprint, products: products, collection: {title: \"All Products\", body_html: \"<p>Browse our complete collection.</p>\"}}}];"
            },
