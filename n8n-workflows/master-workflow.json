                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"custom_collection\": {\n    \"title\": {{ JSON.stringify($json.collection.title) }},\n    \"body_html\": {{ JSON.stringify($json.collection.body_html) }}\n  }\n}",
                "options": {
                    "timeout": 30000,
