        {
            "parameters": {
                "jsCode": "const product = $('Loop Products').first().json.product;\nconst imageData = $input.first().json;\nlet imageUrl = '';\ntry {\n  if (imageData.photos && imageData.photos.length > 0) {\n    imageUrl = imageData.photos[0].src.large;\n  }\n} catch(e) {}\nif (imageUrl) {\n  product.images = [{src: imageUrl}];\n}\nreturn [{json: {product}}];"
            },
