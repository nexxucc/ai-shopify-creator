        {
            "parameters": {
                "jsCode": "const allData = $('Parse Theme & Prep Collections').first().json;\nconst blueprint = allData.blueprint;\nconst pages = (blueprint.requiredPages || ['About', 'Contact', 'FAQ']).filter(p => p !== 'Home').map(pageName => {\n  let body = '';\n  if (pageName === 'About') body = `<h2>About ${blueprint.storeName}</h2><p>Welcome to ${blueprint.storeName}. ${blueprint.tagline || ''}</p><p>We serve ${blueprint.targetAudience || 'our customers'} with quality products.</p>`;\n  else if (pageName === 'Contact') body = `<h2>Contact Us</h2><p>Have questions? We are here to help.</p><p>Email us and we will get back to you within 24 hours.</p>`;\n  else if (pageName === 'FAQ') body = `<h2>Frequently Asked Questions</h2><p><strong>How long does shipping take?</strong></p><p>Standard shipping takes 5-7 business days.</p><p><strong>What is your return policy?</strong></p><p>We offer a 30-day money-back guarantee on all products.</p>`;\n  else body = `<h2>${pageName}</h2><p>Content for ${pageName} page.</p>`;\n  return {json: {page: {title: pageName, body_html: body, published: true}}};\n});\nreturn pages;"
            },
