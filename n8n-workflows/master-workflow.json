        {
            "parameters": {
                "jsCode": "const response = $input.first().json;\nconst blueprint = $('Parse Architect').first().json.blueprint;\nlet products;\ntry { const p = JSON.parse(response.choices[0].message.content); products = Array.isArray(p) ? p : p.products || [p]; } catch(e) { products = []; }\nconst systemPrompt = \"You are an expert eCommerce Content Writer. Write compelling, SEO-optimized product content for Shopify. Respond ONLY with valid JSON. OUTPUT: {products: [{title, content: {title, bodyHtml: string (HTML, 150-300 words), seoTitle: string (max 60 chars), seoDescription: string (max 160 chars)}}]}\";\nconst userPrompt = \"Write content for: \" + JSON.stringify(products.map(function(p){return {title:p.title, shortDescription:p.shortDescription}})) + \". Store: \" + blueprint.storeName + \". Brand Voice: \" + (blueprint.brandVoice || \"Professional\");\nreturn [{json: { blueprint, products, body: { model: \"llama-3.3-70b-versatile\", messages: [{role: \"system\", content: systemPrompt}, {role: \"user\", content: userPrompt}], temperature: 0.7, max_tokens: 8000, response_format: {type: \"json_object\"} }}}];"
            },
