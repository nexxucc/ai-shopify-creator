        },
        {
            "parameters": {
                "jsCode": "const allData = $('Parse Theme & Prep Collections').first().json;\nconst products = allData.products;\nreturn products.map(p => {\n  const price = p.pricing?.finalPrice || p.variants?.[0]?.priceBase || 29.99;\n  const compareAt = p.pricing?.compareAtPrice || p.variants?.[0]?.compareAtPriceBase || null;\n  const content = p.content || {};\n  const tags = (p.tags || []).concat([p.collectionName]).join(', ');\n  const searchTerms = (p.imageSearchTerms || [p.title]).join(' ');\n  return {json: {\n    imageQuery: searchTerms,\n    product: {\n      title: content.title || p.title,\n      body_html: content.bodyHtml || `<p>${p.shortDescription || ''}</p>`,\n      vendor: p.vendor || allData.blueprint.storeName,\n      product_type: p.productType || '',\n      tags: tags,\n      variants: [{option1: 'Default', price: String(price), compare_at_price: compareAt ? String(compareAt) : null, sku: (p.variants?.[0]?.sku_prefix || 'SKU') + '-001', inventory_management: null}],\n      metafields_global_title_tag: content.seoTitle || p.title,\n      metafields_global_description_tag: content.seoDescription || p.shortDescription || ''\n    }\n  }};\n});"
            },
            "id": "node-prep-products",
            "name": "Prepare Products",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
