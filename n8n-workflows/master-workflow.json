        {
            "parameters": {
                "jsCode": "const input = $input.first().json;\nconst systemPrompt = \"You are an expert Shopify Store Architect. Design a complete store blueprint. Respond ONLY with valid JSON. No markdown. OUTPUT: {storeName, tagline, collections: [{name, description}], requiredPages: [string], theme: {style, colors: {primary, secondary, accent}, font}, targetAudience, brandVoice}\";\nconst userPrompt = \"Design a Shopify store for: \" + input.niche + \". Target Audience: \" + input.targetAudience + \". Budget Tier: \" + input.budgetTier + \". USP: \" + input.uniqueSellingPoint + \". Product Count: \" + (input.productCount || 5);\nreturn [{json: { body: { model: \"llama-3.3-70b-versatile\", messages: [{role: \"system\", content: systemPrompt}, {role: \"user\", content: userPrompt}], temperature: 0.7, max_tokens: 4000, response_format: {type: \"json_object\"} }}}];"
            },
