        {
            "parameters": {
                "jsCode": "const response = $input.first().json;\nconst blueprint = JSON.parse(response.choices[0].message.content);\nconst input = $('Set Variables').first().json;\nconst systemPrompt = \"You are an expert eCommerce Product Researcher. Generate winning products for a Shopify store. Respond ONLY with valid JSON. OUTPUT: {products: [{title, productType, vendor, collectionName, shortDescription, tags: [string], variants: [{optionName, options: [string], priceBase: number, compareAtPriceBase: number, sku_prefix}], weight: number, weightUnit: kg, imageSearchTerms: [string], seoKeyword}]}\";\nconst userPrompt = \"Blueprint: \" + JSON.stringify(blueprint) + \". Generate \" + (input.productCount || 5) + \" products for this \" + input.niche + \" store. Budget tier: \" + input.budgetTier;\nreturn [{json: { blueprint, body: { model: \"llama-3.3-70b-versatile\", messages: [{role: \"system\", content: systemPrompt}, {role: \"user\", content: userPrompt}], temperature: 0.7, max_tokens: 8000, response_format: {type: \"json_object\"} }}}];"
            },
