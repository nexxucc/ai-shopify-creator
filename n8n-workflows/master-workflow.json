                "jsCode": "const response = $input.first().json;\nconst prev = $('Parse Content').first().json;\nlet pricingData;\ntry { pricingData = JSON.parse(response.choices[0].message.content); } catch(e) { pricingData = {products: []}; }\nconst products = prev.products.map(function(p, i) { const pricing = (pricingData.products || [])[i] ? (pricingData.products[i].pricing || {}) : {}; return Object.assign({}, p, {pricing: pricing}); });\nconst systemPrompt = \"You are an expert Shopify Theme Consultant. Respond ONLY with valid JSON. OUTPUT: {theme: {primaryColor: hex, secondaryColor: hex, accentColor: hex, fontHeading: string, fontBody: string, style: string}}\";\nconst userPrompt = \"Recommend theme for: \" + (prev.blueprint.storeName || \"Store\") + \". Audience: \" + (prev.blueprint.targetAudience || \"General\") + \". Voice: \" + (prev.blueprint.brandVoice || \"Professional\");\nreturn [{json: { blueprint: prev.blueprint, products, body: { model: \"llama-3.3-70b-versatile\", messages: [{role: \"system\", content: systemPrompt}, {role: \"user\", content: userPrompt}], temperature: 0.7, max_tokens: 2000, response_format: {type: \"json_object\"} }}}];"
