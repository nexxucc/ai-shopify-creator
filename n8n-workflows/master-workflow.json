        {
            "parameters": {
                "method": "POST",
                "url": "=https://{{ $env.SHOPIFY_STORE_DOMAIN }}/admin/api/2024-01/custom_collections.json",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
